# Copie este arquivo para ".env" e ajuste se necessário.
# O arquivo .env NÃO deve ser versionado.
DATABASE_URL="postgresql://sgv:sgv123@localhost:5433/sgv_ellp?schema=public"

# Chave que assina os tokens JWT. Use um texto longo e aleatório (não reutilize este).
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Endereço do front-end, usado no link de validação impresso no termo em PDF
FRONT_URL="http://localhost:5173"

# Primeiro coordenador ADMIN criado pelo "npm run seed"
SEED_ADMIN_EMAIL="admin@ellp.exemplo"
SEED_ADMIN_SENHA="troque-esta-senha"
